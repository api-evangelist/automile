          "name": "Updates the given place with new model",
          "request": {
            "name": "Updates the given place with new model",
            "description": {
              "content": "This will update information on an already existing place, as well as its vehicle connections.\r\n            Vehicle connections to the place will be updated/added from the VehicleIds list if user has edit authorization to the vehicles.\r\n            Already existing vehicle connections be removed if excluded in the VehicleIds list (if authorized to be edited).\r\n            This will update the given place id with a new model.",
              "type": "text/plain"
            },
