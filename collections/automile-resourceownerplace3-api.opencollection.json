            "params": [
              {
                "name": "placeId",
                "value": "",
                "type": "path",
                "description": "The Id of the place"
              }
            ]
          },
          "docs": "Gets place by placeid"
        },
        {
          "info": {
            "name": "Updates the given place with new model",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/resourceowner/place3/:placeId",
            "params": [
              {
                "name": "placeId",
                "value": "",
                "type": "path",
                "description": "The place id"
              }
            ]
          },
          "docs": "This will update information on an already existing place, as well as its vehicle connections.\r\n            Vehicle connections to the place will be updated/added from the VehicleIds list if user has edit authorization to the vehicles.\r\n            Already existing vehicle connections be removed if excluded in the VehicleIds list (if authorized to be edited).\r\n            This will update the given place id with a new model."
