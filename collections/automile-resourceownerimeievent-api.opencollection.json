      "items": [
        {
          "info": {
            "name": "Get a list of all IMEIEvents that user is associated with",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/resourceowner/imeievents"
          },
          "docs": "Only IMEIEvents that the user is associated with will be returned by this operation."
        },
        {
          "info": {
            "name": "Gets MILIMEIevent for given imeiEventId",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/resourceowner/imeievents/mil/:imeiEventId",
            "params": [
              {
                "name": "imeiEventId",
                "value": "",
                "type": "path",
                "description": "The id to IMEIevent"
              }
            ]
          },
          "docs": "The user only has access to IMEIEvents that it is associated with"
        },
        {
          "info": {
